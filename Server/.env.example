# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Local Indiana University (Open-i) index built with:
# python -m ml.build_iu_index --limit 50
RADSYN_INDEX_PATH=data/iu_index.sqlite
RADSYN_DATASET_NAME=Indiana University Chest X-ray (Open-i)

# Backward-compatible alternatives when using an existing MIMIC index:
# RADSYN_MIMIC_INDEX=data/mimic_index.sqlite
# RADSYN_IU_INDEX=data/iu_index.sqlite

# Optional OpenAI-powered historical report summary
OPENAI_API_KEY=
OPENAI_MODEL=

# Similar-case retrieval is only triggered when a class probability is within this distance of its validation threshold
RADSYN_UNCERTAINTY_DELTA=0.12
