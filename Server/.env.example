# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional OpenAI-powered summary. If unset, RadSync returns a local evidence summary.
OPENAI_API_KEY=
OPENAI_MODEL=

# Indiana University / Open-i local retrieval index (preferred when present)
RADSYN_IU_INDEX=data/iu_index.sqlite

# Optional generic override; takes precedence over dataset-specific paths
# RADSYN_RETRIEVAL_INDEX=data/iu_index.sqlite
# RADSYN_DATASET_LABEL=Indiana University Chest X-ray (Open-i)

# Optional explicit legacy MIMIC-CXR index (takes effect when configured)
# RADSYN_MIMIC_INDEX=data/mimic_index.sqlite

# Similar-case retrieval triggers only when a class probability is within this distance of its validation threshold
RADSYN_UNCERTAINTY_DELTA=0.12
